      "updated": 1790578300107,
      "link": null,
      "locked": false,
      "text": "昨日 needs no に. Nouns usually do not mark singular / plural; there are no articles like “a” or “the”.",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "昨日 needs no に. Nouns usually do not mark singular / plural; there are no articles like “a” or “the”.",
      "autoResize": true,
      "lineHeight": 1.25
    },
